# ==================================
# Pflicht fuer DEMO + normalen Betrieb
# ==================================

# iDempiere Verbindung (ohne diese 3 Werte funktioniert kein Login)
IDEMPIERE_BASE_URL=http://localhost:8080/api/v1
IDEMPIERE_USER=GardenAdmin
IDEMPIERE_PASSWORD=your-idempiere-password

# JWT Secret fuer Sessions (in Produktion unbedingt stark setzen)
JWT_SECRET=your-super-secret-key-at-least-32-characters-long


# ==================================
# Optional: globaler Betrieb (DEMO + Login-Flow)
# ==================================

# Backend-Port (Default im Code: 3001)
# PORT=3001

# iDempiere Kontext fuer Admin-Token (Defaults im Code: 11, 102, 11, 1000000, en_US)
# Diese Werte gelten global, nicht nur fuer Demo.
# IDEMPIERE_CLIENT_ID=11
# IDEMPIERE_ROLE_ID=102
# IDEMPIERE_ORG_ID=11
# IDEMPIERE_WAREHOUSE_ID=1000000
# IDEMPIERE_LANGUAGE=en_US

# Katalogfilter (Defaults im Code: 1000000, 104)
# IDEMPIERE_PRODUCT_CATEGORY_ID=1000000
# IDEMPIERE_PRICE_LIST_VERSION_ID=104

# Bestell-Defaults (fuer Demo + normalen Checkout)
# IDEMPIERE_ORDER_ORG_ID=11
# IDEMPIERE_ORDER_DOCTYPE_ID=133
# IDEMPIERE_ORDER_SALESREP_ID=101
# IDEMPIERE_ORDER_PAYMENT_TERM_ID=105
# IDEMPIERE_ORDER_PRICE_LIST_ID=101
# IDEMPIERE_ORDER_SHIPPER_ID=100
# IDEMPIERE_ORDER_PAYMENT_RULE=P
# IDEMPIERE_ORDER_DELIVERY_RULE=S
# IDEMPIERE_ORDER_POREFERENCE=easwebtestfixed

# Registrierung (Default im Code: 1000000)
# IDEMPIERE_REGISTRATION_ROLE_ID=1000000


# ==================================
# Nur fuer Demo-Route relevante User-Fallbacks
# ==================================

# Diese Werte werden in /api/demo/orders/create-and-complete verwendet,
# weil dort keine Anmeldung/JWT vorhanden ist.
# Im normalen Checkout kommen diese Userdaten aus dem Login (JWT).
# IDEMPIERE_ORDER_BPARTNER_ID=1000015
# IDEMPIERE_ORDER_BILL_LOCATION_ID=116
# IDEMPIERE_ORDER_BILL_USER_ID=102


# ==================================
# Derzeit nicht im Order-Flow verwendet (Legacy/Reserve)
# ==================================

# Werden zwar in config.js gelesen, aber aktuell nicht aktiv genutzt.
# IDEMPIERE_ORDER_BPARTNER_LOCATION_ID=1000004
# IDEMPIERE_ORDER_USER_ID=102
# IDEMPIERE_ORDER_BILL_BPARTNER_ID=119
